name=.github/workflows/recent-activity.yml
name: Update recent activity

on:
  schedule:
    # daily at 00:00 UTC
    - cron: '0 0 * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-readme:
    name: Update README Recent Activity
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          persist-credentials: true

      - name: Update recent activity in README
        uses: jamesgeorge007/github-activity-readme@v2
        with:
          # token used to commit changes
          github-token: ${{ secrets.GITHUB_TOKEN }}
          # README path to update
          target-file: README.md
          # Markers in your README
          start-marker: '<!--RECENT_ACTIVITY:start-->'
          end-marker: '<!--RECENT_ACTIVITY:end-->'
          # Maximum number of items to insert (adjust as desired)
          max-entries: 20
          # Include these activity types
          include-commits: true
          include-pulls: true
          include-issues: true
